# Rust
/target/
**/target/

# Node
node_modules/
dist/
*.tsbuildinfo

# Environment and local overrides
.env
.env.*
!.env.example
!*/.env.example
!**/.env.example
*.local

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# Typvia is MPL-2.0 and keeps Espanso at arm's length.
/espanso/

# Tauri generated artifacts (capability schemas and platform scaffolding).
**/src-tauri/gen/

# Native iOS app: apps/ios/project.yml is the source of truth and xcodegen
# derives the Xcode project, the Info.plists and the entitlements from it.
# Tracking the derived copies would give a reader two answers to the same
# question about signing and App Group membership.
apps/ios/*.xcodeproj/
apps/ios/DerivedData/
apps/ios/**/Info.plist
apps/ios/**/*.entitlements

# FFI spike build products and regenerable bindings
spikes/ffi/kotlin/.gradle/
spikes/ffi/kotlin/build/
spikes/ffi/*/generated/
spikes/ffi/swift/ffi-spike-swift

# iOS keyboard spike generated project and build products
native/ios-keyboard/TypviaKbSpike.xcodeproj/
native/ios-keyboard/build/

# Native module build products. Gradle writes absolute host paths into its
# merger and manifest reports, so these must never reach the repository.
native/*/.gradle/
native/*/build/

# The Android host's build products, and the one file that is about this
# machine rather than about the project: local.properties names an SDK path
# that is nobody else's.
apps/android/.gradle/
apps/android/build/
apps/android/*/build/
apps/android/local.properties

apps/desktop/src-tauri/binaries/
vendor/
