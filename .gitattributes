# Line endings
#
# Every text file is stored with LF in the repository and checked out with LF on
# every platform, so a Windows contributor cannot turn a one-line edit into a
# whole-file diff. All tracked text files are already LF, so this rule changes
# nothing about the current tree.
* text=auto eol=lf

# Windows batch and PowerShell scripts are the exception: some Windows shells
# mis-parse an LF-only script, so these are checked out with CRLF while still
# being stored as LF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts and the Gradle wrapper must stay LF even on Windows checkouts.
*.sh text eol=lf
gradlew text eol=lf

# Apple and Android project files are machine-written and must not be
# re-wrapped. They are LF today and both toolchains write LF.
*.pbxproj text eol=lf
*.storyboard text eol=lf
*.xcscheme text eol=lf
*.xcworkspacedata text eol=lf
*.xcsettings text eol=lf
*.plist text eol=lf
*.entitlements text eol=lf

# Binary assets: never diffed, never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.gz binary
*.jar binary
*.keystore binary

# Lockfiles are generated. Marking them collapses them in pull request diffs
# and keeps them out of the repository language statistics.
Cargo.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true
apps/sync-server/go.sum linguist-generated=true

# Platform project scaffolding generated by the Tauri CLI. It is committed so a
# clean checkout builds, but it is not authored product code: keep it out of the
# language statistics and collapsed in review.
apps/mobile/src-tauri/gen/** linguist-vendored=true
apps/desktop/src-tauri/gen/** linguist-vendored=true

# Exception: this file is hand-edited to wire in the IME and share-target
# modules, so it has to stay visible in review.
apps/mobile/src-tauri/gen/android/settings.gradle -linguist-vendored
