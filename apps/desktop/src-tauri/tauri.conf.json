{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "typvia-shell-spike",
  "version": "0.0.0",
  "identifier": "com.typvia.spike.shell",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Typvia Shell Spike",
        "width": 800,
        "height": 600,
        "visible": true
      },
      {
        "label": "panel",
        "title": "Typvia Panel Spike",
        "width": 640,
        "height": 420,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true
      }
    ]
  }
}
