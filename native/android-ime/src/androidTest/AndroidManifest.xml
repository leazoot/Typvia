<?xml version="1.0" encoding="utf-8"?>
<!-- androidTest-only manifest: the host activity below exists solely in the
     self-instrumenting test APK (package dev.typvia.ime.test) and is never
     merged into any product manifest. The test APK also inherits the IME
     service from the library's main manifest, so the closed loop (enable ->
     switch -> insert) runs against the real service without touching the
     installed dev.typvia.mobile app or its data. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="dev.typvia.ime.ImeHostActivity"
            android:exported="false"
            android:label="Typvia IME test host" />
    </application>
</manifest>
