{
  "$comment": "Typvia · Quiet Path design tokens. Values are final. See README.md for the governing rules that make them work.",
  "color": {
    "light": {
      "paper": "#FCFCFA",
      "sunken": "#F7F7F4",
      "edge": "#F2F2EE",
      "tray": "#F6F6F2",
      "hairline": "#E7E7E2",
      "hairlineHover": "#D8D8D1",
      "hairlineQuiet": "#F4F4EF",
      "ink": "#1B1C1D",
      "secondary": "#54575B",
      "meta": "#686B70",
      "$textFloor": "meta — nothing lighter clears 4.5:1 at 9-12px; there is no fourth grey",
      "accent": "#4C6E8F",
      "accentTintBg": "#F1F4F7",
      "accentTintBorder": "#DFE7EF",
      "success": "#4E7A5A",
      "warning": "#A8792E",
      "warningText": "#7B6122",
      "error": "#A84F45",
      "errorBorder": "#E9DAD8",
      "dangerTray": "#FBF7F6",
      "dangerTrayBorder": "#EFE0DD",
      "diffRemoveBg": "#FBF7F6",
      "diffRemoveGutter": "#F7F0EE",
      "diffAddBg": "#F6F9F7",
      "diffAddGutter": "#EEF4F0",
      "matchHighlight": "#DCE6EF"
    },
    "dark": {
      "paper": "#191A1A",
      "sunken": "#131414",
      "edge": "#202121",
      "lifted": "#242525",
      "liftedBorder": "#343535",
      "hairline": "#2C2D2D",
      "hairlineQuiet": "#222323",
      "hairlineFaint": "#1F2020",
      "ink": "#F2F2EE",
      "secondary": "#C9CDD1",
      "meta": "#9DA1A6",
      "$textFloor": "meta — the graphite floor",
      "accent": "#7FA3C4",
      "accentTintBg": "#1E2529",
      "accentTintBorder": "#2E3A42",
      "success": "#6E9C7E",
      "warning": "#C9A055",
      "error": "#C97A70",
      "$note": "light accent #4C6E8F measures 3.3:1 on graphite and must not be used here"
    }
  },
  "font": {
    "sans": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "mono": "\"IBM Plex Mono\", monospace",
    "cjk": "\"PingFang SC\", \"Microsoft YaHei\", sans-serif",
    "$cjkRule": "CN line-height is always +0.15 over the EN value at the same size"
  },
  "type": {
    "display": { "size": 58, "weight": 400, "tracking": "-0.035em", "leading": 1.02 },
    "heroSearch": { "size": 40, "weight": 400, "tracking": "-0.032em", "leading": 1.05 },
    "pageTitle": { "size": 34, "weight": 400, "tracking": "-0.03em", "leading": 1.15 },
    "sectionTitle": { "size": 26, "weight": 400, "tracking": "-0.028em", "leading": 1.2 },
    "subPageTitle": { "size": 25, "weight": 400, "tracking": "-0.026em", "leading": 1.2 },
    "librarySearch": { "size": 24, "weight": 400, "tracking": "-0.025em", "leading": 1 },
    "cardTitle": { "size": 19, "weight": 400, "tracking": "-0.022em", "leading": 1.25 },
    "panelSearch": { "size": 17, "weight": 400, "tracking": "-0.015em", "leading": 1 },
    "mobileRow": { "size": 14.5, "weight": 400, "leading": 1.3 },
    "editorBody": { "size": 14.5, "weight": 400, "leading": 2.05 },
    "desktopRow": { "size": 13.5, "weight": 400, "leading": 1 },
    "body": { "size": 13, "weight": 400, "leading": 1.7 },
    "code": { "size": 12.5, "weight": 400, "leading": 1.8, "family": "mono" },
    "meta": { "size": 11.5, "weight": 400, "leading": 1 },
    "keyBadge": { "size": 10, "weight": 500, "leading": 1, "family": "mono" },
    "sectionLabel": {
      "size": 9,
      "weight": 500,
      "leading": 1,
      "family": "mono",
      "tracking": "0.14em",
      "case": "uppercase"
    },
    "typeMark": { "size": 9, "weight": 500, "leading": 1, "family": "mono", "tracking": "0.04em" }
  },
  "radius": {
    "mark": 4,
    "chip": 6,
    "row": 9,
    "field": 11,
    "card": 12,
    "panel": 15,
    "sheetTop": 16,
    "overlay": 19,
    "bezelAndroid": 34,
    "bezelIPhone": 44,
    "$rule": "nothing is a pill and nothing is a circle, except the status dot and the toggle"
  },
  "space": {
    "scale": [6, 7, 8, 9, 11, 13, 14, 18, 22, 26, 34, 40, 44],
    "desktopPagePadding": 40,
    "mobilePagePadding": 22,
    "rowHeightDesktop": 52,
    "rowHeightLedger": 44,
    "rowHeightSelected": 46,
    "touchStrip": 64,
    "keyboardStrip": 52,
    "mobileButton": 50,
    "tabItem": 48,
    "chipTouch": 44
  },
  "elevation": {
    "e0": "none",
    "e1": "0 1px 2px rgba(27,28,29,.04), 0 4px 12px -8px rgba(27,28,29,.14)",
    "e1Row": "0 1px 2px rgba(27,28,29,.05), 0 8px 20px -12px rgba(27,28,29,.22)",
    "e2": "0 2px 6px rgba(27,28,29,.05), 0 16px 40px -20px rgba(27,28,29,.24)",
    "e3": "0 4px 10px rgba(27,28,29,.06), 0 40px 80px -32px rgba(27,28,29,.32)",
    "$rule": "cross-fade a duplicated layer; never animate box-shadow directly"
  },
  "motion": {
    "curve": {
      "standard": "cubic-bezier(.2, .7, .2, 1)",
      "exit": "cubic-bezier(.4, 0, 1, 1)",
      "linear": "linear"
    },
    "duration": {
      "press": 80,
      "hover": 100,
      "selectionTravel": 140,
      "overlayEnter": 190,
      "overlayExit": 130,
      "containerResize": 220,
      "vaultReveal": 260,
      "ambientLoop": 2600,
      "toastLife": 1600
    },
    "$exitRule": "exit is always 0.7x the enter duration of the same element",
    "$maxScale": 1.02,
    "animatable": [
      "transform",
      "opacity",
      "filter:blur (vault only)",
      "height (measured, never auto)",
      "background (hover only)"
    ],
    "neverAnimate": ["caret position", "security state", "search results", "page transitions"]
  },
  "focus": {
    "ring": "0 0 0 2px <surface>, 0 0 0 3.5px <accent>",
    "trigger": ":focus-visible only",
    "$contrast": "measured >=3:1 against paper, sunken and graphite"
  },
  "scrim": {
    "modal": "rgba(27,28,29,.28)",
    "$rule": "no backdrop blur"
  },
  "typeMarks": {
    "TX": "Text",
    "CD": "Code",
    "CM": "Command",
    "PR": "Prompt",
    "TP": "Template",
    "SC": "Secret",
    "AI": "AI action",
    "LK": "Link",
    "$rule": "only SC is accent-tinted; all others are neutral"
  },
  "icon": {
    "box": 20,
    "safeMargin": 2,
    "stroke": 1.5,
    "corners": [2, 3],
    "sizes": [16, 20, 24],
    "$strokeRule": "stroke stays 1.5px at every size — it does not scale",
    "$construction": "rectangles, circles and 45-degree lines only",
    "$accentBarExceptions": ["cursor", "insert"]
  },
  "breakpoint": {
    "reference": 1360,
    "drawerPreview": 1160,
    "railCollapse": 840,
    "$below840": "the mobile layout",
    "landscapeTwoPane": 700
  }
}
