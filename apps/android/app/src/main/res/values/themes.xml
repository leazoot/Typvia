<resources>
    <!--
      The window is paper before Compose draws anything: a launch that flashes
      the platform's own white and then repaints cream is a launch that reads
      as two apps starting.
    -->
    <style name="Theme.Typvia" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
    </style>
</resources>
