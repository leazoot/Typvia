<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget metadata. Event-driven refresh only:
     updatePeriodMillis is 0 and the host pokes after each snapshot write.
     home_screen category only - lock-screen surfaces stay pure entry points
     and Android keyguard widgets are not part of this design. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_typvia"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:previewLayout="@layout/widget_typvia"
    android:resizeMode="vertical|horizontal"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
